# My Beer Log - Frontend Environment Variables
# Copy this file to .env.local and fill in the appropriate values

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Application Name
NEXT_PUBLIC_APP_NAME="My Beer Log"

# Environment (development, staging, production)
NODE_ENV=development

# ===========================================
# API CONFIGURATION
# ===========================================

# Backend API Base URL
# Local: http://localhost:8080
# Development: https://e9iqvu1ilg.execute-api.ap-northeast-1.amazonaws.com/dev
# Staging: https://api-staging.mybeerlog.com
# Production: https://api.mybeerlog.com
NEXT_PUBLIC_API_BASE_URL=

# API Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=

# API Retry Attempts
NEXT_PUBLIC_API_RETRY_ATTEMPTS=

# ===========================================
# AWS AMPLIFY CONFIGURATION
# ===========================================

# AWS Region where your Cognito User Pool is located
NEXT_PUBLIC_AWS_REGION=

# AWS Cognito User Pool ID
# Example: us-east-1_AbCdEfGhI
NEXT_PUBLIC_USER_POOL_ID=

# AWS Cognito User Pool Web Client ID
# Example: 1a2b3c4d5e6f7g8h9i0j1k2l3m
NEXT_PUBLIC_USER_POOL_WEB_CLIENT_ID=

# ===========================================
# NOTES
# ===========================================
# 
# 1. NEXT_PUBLIC_ プレフィックスの付いた変数はブラウザに公開されます
# 2. NEXT_PUBLIC_ プレフィックスのない変数はサーバーサイドでのみ使用されます
# 3. .env.local をバージョン管理にコミットしないでください
# 4. 開発、ステージング、本番環境で異なる値を使用してください
# 5. 環境変数を変更した後は開発サーバーを再起動してください
#
# Next.js の環境変数についての詳細情報：
# https://nextjs.org/docs/basic-features/environment-variables